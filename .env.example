# Browser-visible values. Use a publishable key, NEVER a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://gattldfwkbvkxodshzwb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Use the deployed HTTPS origin in production/preview.
APP_URL=http://localhost:3000
SOURCE_SIGNED_URL_TTL_SECONDS=60

# Required for source indexing and AI request logging (server only).
# Store a real value in the hosting secret store or ignored .env.local.
SUPABASE_SECRET_KEY=

# Vercel Cron: daily final deletion of trash older than 30 days (/api/cron/purge-trash).
# Random string, 16+ characters; Vercel sends it as Authorization: Bearer <value>.
CRON_SECRET=

# External SMTP for Auth e-mails is configured separately in Supabase Auth.
# See .env.smtp.example and docs/environments.md.
# Optional (server only): the same SMTP values let the app send workspace
# invitations. Without them the owner gets a link to pass on manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nexora

# ИИ-провайдер (только сервер, никогда не префиксовать NEXT_PUBLIC_)
AI_PROVIDER=xai
AI_MODEL=grok-4.7
# xAI API key when AI_PROVIDER=xai; never expose it via NEXT_PUBLIC_.
AI_API_KEY=
# Document indexing/search still uses a separate OpenAI embeddings key.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# Лимиты (ТЗ п. 4.2.6, 4.2.8) — можно менять без правки кода
MAX_UPLOAD_MB=25
WORKSPACE_MAX_SOURCES=100
WORKSPACE_MAX_MB=500
AI_REQUESTS_PER_HOUR=30
SEARCH_MIN_SIMILARITY=0.3
