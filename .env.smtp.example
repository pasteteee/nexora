# Operations only. Copy to .env.smtp.local (ignored), never to client variables.
# This file is NOT loaded by Next.js. It is read only by scripts/supabase-smtp.mjs.
SUPABASE_PROJECT_REF=gattldfwkbvkxodshzwb
SUPABASE_ACCESS_TOKEN=

# Gmail: enable 2-Step Verification and create a Google App Password.
# SMTP_USER and SMTP_FROM_EMAIL must be the same full Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nexora

# A mailbox you own and explicitly authorize for one test message.
SMTP_TEST_TO=
