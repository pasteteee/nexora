{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:infra": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:db:remote": "node scripts/test-database.mjs --remote-rollback",
    "test:storage:remote": "node scripts/test-storage-remote.mjs --remote-fixtures",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "perf:board": "node scripts/perf-board.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "smtp:check": "node scripts/supabase-smtp.mjs --check",
    "smtp:configure": "node scripts/supabase-smtp.mjs --apply",
    "smtp:test": "node scripts/supabase-smtp.mjs --send-test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "fast-xml-parser": "5.12.0",
    "fflate": "^0.8.3",
    "html-to-image": "1.11.13",
    "katex": "0.19.1",
    "lucide-react": "0.546.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "0.16.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.11.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
